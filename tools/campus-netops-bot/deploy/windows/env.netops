# .env của NetOps-Server (DHCP-Server 72, 10.1.90.10) — quản trị in-band, KHÔNG có quyền vào server EVE.
# Điền TELEGRAM_BOT_TOKEN, TELEGRAM_ALLOWED_CHAT_IDS, API_KEY trực tiếp trên máy chủ (C:\netops\app\.env).
API_KEY=
# LLM chuẩn OpenAI. Đổi sang Google AI Studio: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash, LLM_RPS=0.15, bỏ LLM_FALLBACK_MODELS (chỉ OpenRouter hiểu).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free
LLM_RPS=0.3
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

NETOPS_TRANSPORT=ssh
NETOPS_CRED_TAG=netops (SSH Site 100)
NETOPS_FW_CRED_TAG=netops FW
CAMPUS_CRED_FILE=C:\netops\secrets\credentials.md

# Ryu trên VLAN 99 (đi qua Core, cùng mạng nội bộ — không qua tunnel)
SDN_CTL=http://10.1.99.10:8080
SDN_DIRECT=1
# vManage đi theo đường Internet của lab (Site 100 DIA → router Internet → Switch32)
VMANAGE_URL=https://10.9.0.10
VMANAGE_DIRECT=1
VMANAGE_CRED_TAG=vManager (33)

# configs/ chép kèm bộ cài để /backup, /drift so lệch
CAMPUS_CONFIGS_DIR=C:\netops\configs
NETOPS_LOG_DIR=C:\netops\logs

ALERT_ENABLED=1
ALERT_INTERVAL=60
ALERT_STATE_FILE=C:\netops\logs\alert_state.json
CHANGE_AUDIT_LOG=C:\netops\logs\audit.log
CHANGE_FOUR_EYES=0
