# Chép thành .env (KHÔNG commit .env). Không ghi mật khẩu thiết bị ở đây.

# LLM chuẩn OpenAI (mặc định OpenRouter, model free). Google AI Studio:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash  LLM_RPS=0.15
API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# chỉ OpenRouter: model dự phòng khi model chính lỗi/quá tải
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free
LLM_RPS=0.3

# Telegram: token từ BotFather; danh sách chat_id được phép, cách nhau bằng dấu phẩy
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Server EVE-NG (IP Tailscale của EVE-NG SDWAN_LAB; LAN 10.215.26.50)
EVE_HOST=100.86.110.39
EVE_TENANT=0
# Khoá dòng trong file credentials dùng để SSH vào server EVE
EVE_CRED_TAG=EVE-NG SDWAN_LAB

# File credentials cục bộ (bảng Markdown, nằm ngoài repo)
CAMPUS_CRED_FILE=~/.claude/campus-lab-credentials.md

# --- Giai đoạn 2: REST + cảnh báo ---
# vManage (qua tunnel SSH của server EVE; đặt VMANAGE_DIRECT=1 nếu bot chạy ngay trên server EVE)
VMANAGE_URL=https://10.9.1.10
VMANAGE_CRED_TAG=vManager (33)
# Ryu REST trên ens6 của node 9 (IP DHCP, đổi theo lần boot) — để trống thì bỏ qua phần SDN
SDN_CTL=
# Cảnh báo chủ động lên Telegram
ALERT_ENABLED=1
ALERT_INTERVAL=60
# để trống = gửi cho mọi chat trong TELEGRAM_ALLOWED_CHAT_IDS
ALERT_CHAT_IDS=
ALERT_NOISY_TYPES=cpu-usage,memory-usage,disk-usage
ALERT_STALL_MS=6000

# --- Giai đoạn 3: thay đổi có duyệt ---
# user id Telegram được bấm Duyệt/Hoàn tác (rỗng = mọi chat trong TELEGRAM_ALLOWED_CHAT_IDS)
CHANGE_APPROVER_IDS=
# 1 = người duyệt phải khác người yêu cầu
CHANGE_FOUR_EYES=0
CHANGE_PENDING_TTL=600
CHANGE_UNDO_WINDOW=3600
CHANGE_SETTLE_IOS=15
CHANGE_SETTLE_VIPTELA=40
CHANGE_AUDIT_LOG=

# NetBox (tuỳ chọn)
NETBOX_URL=
NETBOX_TOKEN=
